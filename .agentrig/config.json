{
  "checks": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "preflight": "pnpm test:preflight",
    "steps": [
      { "name": "build", "command": "pnpm build" },
      { "name": "test", "command": "pnpm test", "countsParser": "vitest" },
      { "name": "typecheck", "command": "pnpm typecheck" }
    ]
  },
  "reviewers": {
    "Claude Code": {
      "adapter": "claude-cli",
      "model": "claude-opus-5"
    },
    "Codex": {
      "adapter": "codex-cli",
      "model": "gpt-5.6-sol"
    }
  }
}
