{
  "name": "@agentkitai/agentrig-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Thin CLI over the SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@agentkitai/agentrig-core": "workspace:*",
    "@agentkitai/agentrig-memory": "workspace:*",
    "@agentkitai/agentrig-supervisor": "workspace:*",
    "commander": "^12.1.0",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "zod": "^3.25.76"
  },
  "bin": {
    "agentrig": "./dist/index.js"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0"
  }
}
