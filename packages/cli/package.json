{
  "name": "@agentkitai/agentrig-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Thin CLI over the SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@agentkitai/agentrig-core": "workspace:*",
    "@agentkitai/agentrig-memory": "workspace:*",
    "@agentkitai/agentrig-supervisor": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "8.20.0",
    "commander": "^12.1.0",
    "diff": "9.0.0",
    "ink": "^5.2.1",
    "lowlight": "3.3.0",
    "marked": "18.0.11",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "tar-stream": "3.2.1",
    "ws": "8.21.3",
    "zod": "^3.25.76"
  },
  "bin": {
    "agentrig": "./dist/index.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/react": "^18.3.31",
    "@types/ws": "8.18.1",
    "ink-testing-library": "^4.0.0",
    "playwright": "1.63.0",
    "tsx": "^4.19.0"
  }
}
